---
import type { Heading } from "@/utils/getHeadings";

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

if (headings.length < 3) return null;
---

<nav class="border-border my-6 rounded-lg border p-4">
  <h2 class="mb-3 text-lg font-semibold">Table of Contents</h2>
  <ul class="text-sm">
    {
      headings.map(h => (
        <li
          class:list={[
            "py-1",
            h.depth === 3 && "ps-4",
            h.depth === 4 && "ps-8",
          ]}
        >
          <a
            href={`#${h.slug}`}
            class="text-muted-foreground hover:text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
