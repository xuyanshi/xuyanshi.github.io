---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const tz = postTimezone ?? config.site.timezone;

const pubDate = dayjs(pubDatetime).tz(tz).format("D MMM, YYYY");
const isModified =
  modDatetime && dayjs(modDatetime).tz(tz).format("D MMM, YYYY") !== pubDate;
const modDate = isModified
  ? dayjs(modDatetime).tz(tz).format("D MMM, YYYY")
  : null;
---

<div
  class:list={[
    "text-muted-foreground flex flex-wrap items-center gap-x-2",
    className,
  ]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={dayjs(pubDatetime).toISOString()}
  >
    <span data-i18n="post.publishedAt">{t.post.publishedAt}</span>: {pubDate}
  </time>
  {
    modDate && (
      <>
        <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
          ·
        </span>
        <time
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
          datetime={dayjs(modDatetime).toISOString()}
        >
          <span data-i18n="post.updatedAt">{t.post.updatedAt}</span>: {modDate}
        </time>
      </>
    )
  }
</div>
